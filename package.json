{
  "name": "hackhost",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=@hackhost/marketing --filter=@hackhost/app",
    "dev:marketing": "pnpm --filter @hackhost/marketing dev",
    "dev:app": "pnpm --filter @hackhost/app dev",
    "build": "turbo build --filter=@hackhost/marketing --filter=@hackhost/app",
    "build:marketing": "pnpm --filter @hackhost/marketing build",
    "build:app": "pnpm --filter @hackhost/app build",
    "start": "turbo start --filter=@hackhost/marketing --filter=@hackhost/app",
    "start:marketing": "pnpm --filter @hackhost/marketing start",
    "start:app": "pnpm --filter @hackhost/app start",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @hackhost/db generate",
    "db:migrate": "pnpm --filter @hackhost/db migrate",
    "db:push": "pnpm --filter @hackhost/db push",
    "db:seed": "pnpm --filter @hackhost/db seed",
    "db:studio": "pnpm --filter @hackhost/db studio"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  }
}
